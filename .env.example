# Wild Ones LLC - October launch environment variable checklist
# Copy to a local .env only when testing with Netlify Dev.
# Never commit real values.

TURNSTILE_SITE_KEY=replace-with-cloudflare-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-secret-key

# Shared secret. The same value must be configured on wildonesllc.com
# and the koasevents.com CRM environment.
WILD_ONES_INGEST_SECRET=replace-with-long-random-secret

# Optional override. Defaults to https://koasevents.com/api/crm/inquiries
KOA_CRM_INGEST_URL=https://koasevents.com/api/crm/inquiries

# Signs temporary links to privately stored production riders.
PRODUCER_UPLOAD_SECRET=replace-with-long-random-secret

# Signs producer-only technical-packet session links.
PRODUCER_ACCESS_SECRET=replace-with-long-random-secret

# Protects the server endpoint that generates producer access links.
PRODUCER_ACCESS_ADMIN_KEY=replace-with-long-random-admin-key
