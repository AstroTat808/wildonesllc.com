{
  "name": "wildonesllc-com",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preview": "node scripts/preview-server.mjs --port 8080",
    "qa:static": "node scripts/qa-static.mjs",
    "qa:browser": "playwright test",
    "qa:lighthouse": "lhci autorun --config=./lighthouserc.json",
    "release:certify": "npm run design:check && npm run qa:static && npm run qa:functions && npm run qa:browser && npm run qa:visual",
    "qa:functions": "node --experimental-strip-types scripts/qa-functions.mjs",
    "design:check": "node scripts/design-fixer.mjs --check",
    "design:fix": "node scripts/design-fixer.mjs --fix",
    "qa:visual": "playwright test --config=playwright.visual.config.mjs",
    "quality:build": "node scripts/build-quality-dashboard.mjs",
    "qa:netlify": "npm run design:check && npm run qa:static && npm run qa:functions",
    "qa:lighthouse:all": "lhci autorun --config=./lighthouserc.all.json"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "@netlify/edge-functions": "4.0.2",
    "@netlify/functions": "6.0.2"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0"
  }
}
